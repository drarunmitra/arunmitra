@inproceedings{mitra2021hsr,
  title = {Tracking and Monitoring {{COVID-19}} in {{Kerala}}: {{Development}} of an Interactive Dashboard},
  booktitle = {Health {{System Research}}},
  author = {Mitra, Arun and Soman, Biju and Gaitonde, Rakhal and Singh, Gurpreet and Roy, Adrija},
  year = {2021},
  month = oct,
  address = {Cochin, Kerala},
  abstract = {Introduction: The rapid spread of the COVID-19  pandemic has demanded collective action against  coronavirus disease on an unprecedented scale.  Governments, industry and citizens joined hands to bring  about technological innovations like crowd-sourced data  generation, mobile applications and dashboards which  became quickly popular in the public health landscape.  Despite showing initial promise, these tools failed to  play a huge role in aiding the public health decision  making process, especially in the Indian context. Some  of the reasons are the lack of transparent mechanisms  to process and transform huge volume of information  inflow into actionable evidence leading to poor quality  evidence, lack of trust in the data. Also, in the context  of Kerala, though the data is technically `available' for  public use, it is not available in formats that is analysable.  Given these challenges, the authors adopt a data science  approach for this case-study to provide a robust, reliable  and reproducible solution to develop an interactive  dashboard to track and monitor COVID-19 in Kerala. gestational age of 36.1 {\textpm} 3.2 weeks. Receiver operating  characteristic curve (ROC) for sepsis markers showed  that procalcitonin demonstrated the highest sensitivity  and specificity of 90.9\% and 100\%, respectively; AUC of  0. 966 (95\% CI, 0.862-0.998, p {$<$}0.001) with cut off {$\leq$}0.48.  IL-6 significantly predicted early- onset neonatal sepsis  with an AUC of 0.965 (95\% CI, 0.861-0.997, p {$<$}0.001);  optimum cut off{$\leq$} 6.4pg/ml with sensitivity and specificity  of 90.9\% and 95.5\%, respectively. The sensitivity and  specificity for CRP were 81.8\% and 31.8\%, respectively.  WBC and ANC did not significantly predict early onset  neonatal sepsis with sensitivities and specificities of  81.8\%, 86.4\% and 40.9\%,36.4\% respectively. Conclusion: Though blood culturing is the gold standard  for diagnosis of early onset neonatal sepsis, the  inflammatory markers can also assist in diagnosing early  onset neonatal sepsis at the earliest. The procalcitonin  and IL-6 provide better sensitivity and specificity in  diagnosis of early onset neonatal sepsis as compared to  CRP, WBC and ANC through cord blood sampling. Objectives: In this study we demonstrate the utility of  the data science approach using open-source tools  and publicly available data to develop an interactive  dashboard for tracking and monitoring COVID-19 in  Kerala. Methods: The dashboard uses publicly available data  such as spreadsheets and daily information bulletins  from governmental sources, crowdsourced databases,  sero-surveillance studies and population mobility  information from Google Mobility Reports. Some of the  epidemiological parameters estimated include growth  rate, doubling time, effective reproduction number,  active case density, mortality estimates, test positivity  rate, tests per million, vaccination rate, proportion of  infected population among others. Open- source tools  such as R, R Studio and Shiny were used to develop and  deploy the dashboard. Results: The interactive dashboard can be accessed online  (https://amchss-sctimst.shinyapps.io/covid\_dashboard).  Some salient features of the dashboard are interactive  nature, real-time analytics, data integration and linkage,  scalability and adherence to the tenets of open science  and reproducible research. Conclusion: The study demonstrates the usefulness  of data science approach coupled with robust  epidemiological techniques in the application and  development of an interactive and intuitive dashboard  for aiding public health managers with actionable  evidence in decision making for COVID-19 in Kerala},
  copyright = {All rights reserved},
  keywords = {proceedings}
}

