@book{singh2024,
  title = {Time {{Series Forecasting Using R}}},
  author = {Singh, Gurpreet and Yadav, Arun and Soman, Biju and Mitra, Arun},
  year = {2024},
  month = mar,
  url = {https://drgurpreet.github.io/time_series_IPHACON2024/},
  abstract = {The time series forecasting workshop is an introductory half day workshop planned as a pre-conference CME for the participants of IPHACON 2024. The workshop introduces the participants to the concept of time series, its features, characteristics and components. This is followed by introduction to time series analysis and commonly used ARIMA and ETS models. The workshop resource material also introduces Modeltime workflow to the participants. The handbook is available at https://drgurpreet.github.io/time_series_IPHACON2024/}
